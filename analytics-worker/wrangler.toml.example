name = "ghosts-in-shells-analytics"
main = "src/worker.js"
compatibility_date = "2026-07-01"

[[env.staging.d1_databases]]
binding = "DB"
database_name = "ghosts-in-shells-analytics-staging"
database_id = "REPLACE_WITH_STAGING_D1_DATABASE_ID"
migrations_dir = "migrations"

[[env.staging.ratelimits]]
name = "EVENTS_RATE_LIMITER"
namespace_id = "1101"
[env.staging.ratelimits.simple]
limit = 120
period = 60

[[env.staging.ratelimits]]
name = "INVITES_RATE_LIMITER"
namespace_id = "1102"
[env.staging.ratelimits.simple]
limit = 30
period = 60

[env.staging.vars]
ALLOWED_ORIGINS = "http://localhost:8000,http://127.0.0.1:8000"
TEST_MODE = "true"

[[env.production.d1_databases]]
binding = "DB"
database_name = "ghosts-in-shells-analytics-production"
database_id = "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID"
migrations_dir = "migrations"

[[env.production.ratelimits]]
name = "EVENTS_RATE_LIMITER"
namespace_id = "1201"
[env.production.ratelimits.simple]
limit = 120
period = 60

[[env.production.ratelimits]]
name = "INVITES_RATE_LIMITER"
namespace_id = "1202"
[env.production.ratelimits.simple]
limit = 30
period = 60

[env.production.vars]
ALLOWED_ORIGINS = "https://ghostsinshells.com"
TEST_MODE = "false"
